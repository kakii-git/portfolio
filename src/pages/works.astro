---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import PageIndex from "../components/PageIndex.astro";
import Works from "../components/Works.astro";
import Footer from "../components/Footer.astro";
import type { NavItem } from "../types";

// Works ページのセクション（記事は /blog/ へ切り出したので制作物のみ）
const sections: NavItem[] = [{ id: "works", num: "00", label: "制作物" }];
const numOf = (id: string) => sections.find((s) => s.id === id)!.num;
---

<Base title="Works — ka.kii" description="ka.kii の制作物の一覧。">
  <Header nav={sections} />
  <main class="container">
    <PageIndex nav={sections} />
    <Works num={numOf("works")} />
  </main>
  <Footer />
</Base>
